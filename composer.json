{
    "name": "practo/mds-bundle",
    "description": "Symfony2 Bundle for Master Data Service",
    "keywords": ["practo", "mds"],
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Narayana Kotipalli",
            "email": "narayana.kotipalli@practo.com"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "symfony/framework-bundle": ">=2.0",
        "practo/grpc": "dev-master"
    },
    "autoload": {
      "classmap": ["PractoMdsBundle.php"], 
      "psr-4": {
        "Practo\\MDS\\RPC\\": "RPC/", 
        "Practo\\MDS\\DependencyInjection\\":"DependencyInjection/",
        "GPBMetadata\\": "GPBMetadata/" 
      }
    }
}
