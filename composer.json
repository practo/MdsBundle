{
    "name": "practo/mds-bundle",
    "description": "Symfony2 Bundle for Master Data Service",
    "keywords": ["practo", "mds"],
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Narayana Kotipalli",
            "email": "narayana.kotipalli@practo.com"
        },
        {
            "name": "Ronil Merchant",
            "email": "ronil.merchant@practo.com"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "symfony/framework-bundle": ">=2.0",
        "grpc/grpc": "dev-master#7b692ca67b69eb322c774845d639686bbcceb959",
        "guzzlehttp/guzzle": "^6.2",
        "jms/serializer": "master"
    },
     "repositories": [{
        "type": "git",
        "url": "https://github.com/practo/SensioBuzzBundle.git"
    }],
    "autoload": {
      "classmap": ["PractoMdsBundle.php"], 
      "psr-4": {
        "Practo\\MDS\\Model\\": "Model/", 
        "Practo\\MDS\\DependencyInjection\\":"DependencyInjection/",
        "Practo\\MDS\\Utility\\":"Utility",
        "Practo\\MDS\\Config\\":"Config",
        "GPBMetadata\\": "GPBMetadata/" 
      }
    }
}
